/target
# Per-developer build env (signing identities, SDK paths). cargo truce
# reads this file for [env] values - keep it out of the repo.
/.cargo/config.toml

# Finder and AppleDouble metadata, including files inside docs or samples.
**/.DS_Store
**/._*
.AppleDouble
.LSOverride

# Plugin bundles and local signing/debug output.
*.component/
*.vst3/
*.clap/
*.aaxplugin/
*.dSYM/

# Per-developer credentials and scratch settings.
.env
.env.*
!.env.example
*.swp
*~

# Release zips pulled by site/deploy.sh
/site/downloads/
.superpowers/
